{
  "name": "cc-intel",
  "version": "0.2.2",
  "description": "Local-first CLI tool that strengthens Claude Code reliability by monitoring context, extracting knowledge, and preserving decisions into memory",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cc-intel": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/postinstall.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "context",
    "context-guardian",
    "memory",
    "memory-md",
    "compaction",
    "cli",
    "developer-tools",
    "ai-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tornike14/cc-intel.git"
  },
  "homepage": "https://github.com/tornike14/cc-intel#readme",
  "bugs": {
    "url": "https://github.com/tornike14/cc-intel/issues"
  },
  "license": "MIT",
  "author": "tornike14",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@inquirer/select": "^5.1.0",
    "cc-intel": "^0.2.0",
    "commander": "^13.1.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/proper-lockfile": "^4.1.4",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.2"
  }
}
